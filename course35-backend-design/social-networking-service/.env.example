# Production (MySQL)
DATABASE_DSN="mysql:host=127.0.0.1;dbname=social_networking;charset=utf8mb4"
DATABASE_USER="app_user"
DATABASE_PASSWORD="change-me"

# Key used to encrypt direct messages at rest (AES-256-GCM).
# Use a base64-encoded 32-byte key, e.g. generated with:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Keep one .env per server (local / staging / production) and never
# commit the real key.
DM_ENCRYPTION_KEY="change-me-to-a-base64-32-byte-key"

# Local smoke test (SQLite) — copy to .env and use this DSN instead:
# DATABASE_DSN="sqlite:/tmp/social_networking.sqlite"
