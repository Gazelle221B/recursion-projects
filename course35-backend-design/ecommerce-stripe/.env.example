# Environment: local / staging / production. Keep one .env per
# server, each with that environment's own Stripe TEST keys and
# webhook endpoint (the course treats even production as a test-mode
# prototype).
APP_ENV="local"

# Production (MySQL)
DATABASE_DSN="mysql:host=127.0.0.1;dbname=ecommerce_stripe;charset=utf8mb4"
DATABASE_USER="app_user"
DATABASE_PASSWORD="change-me"

# Stripe keys. Leave STRIPE_SECRET_KEY empty to run in DEMO MODE:
# no real HTTP calls are made, checkout is served by a local demo
# page, product deletions are queued in stripe_sync_queue, and the
# webhook accepts the documented unsigned test payloads.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret (whsec_...). When set, webhook signatures
# are verified with hash_hmac + hash_equals.
STRIPE_WEBHOOK_SECRET=""

# Set to "mail" to also send tracking emails through PHP mail();
# messages are always written to storage/outbox/.
MAIL_DELIVERY="outbox"

# Local smoke test (SQLite) — copy to .env and use this DSN instead:
# DATABASE_DSN="sqlite:/tmp/ecommerce_stripe.sqlite"
