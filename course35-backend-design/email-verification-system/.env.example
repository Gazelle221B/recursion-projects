# Production (MySQL)
DATABASE_DSN="mysql:host=127.0.0.1;dbname=email_verification;charset=utf8mb4"
DATABASE_USER="app_user"
DATABASE_PASSWORD="change-me"

# Secret used to sign verification URLs (use a long random value)
SIGNATURE_SECRET_KEY="change-me-to-a-long-random-string"

# Set to "mail" to also send through PHP mail(); messages are always
# written to storage/outbox/ so the flow works without a mail server.
MAIL_DELIVERY="outbox"

# Local smoke test (SQLite) — copy to .env and use this DSN instead:
# DATABASE_DSN="sqlite:/tmp/email_verification.sqlite"
